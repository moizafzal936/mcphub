# Copy to deploy/.env on the server (cp .env.example .env), fill in, then: chmod 600 .env

# Your server's public hostname, without https://.
# Free option: the server's IPv4 address with dashes instead of dots, plus .sslip.io
# e.g. for 203.0.113.10 use 203-0-113-10.sslip.io
MCPHUB_DOMAIN=

# 32 random bytes. Generate on the server with: openssl rand -base64 32
# Save a copy in your password manager: without it, stored API keys can't be decrypted,
# and a backup of the database is useless.
MCPHUB_ENCRYPTION_KEY=

# Keep sign-up closed. You create your own account with the create-operator command.
MCPHUB_ALLOW_SIGNUP=false

# Leave empty: the Playground calls the Anthropic API, which is billed per use.
ANTHROPIC_API_KEY=
