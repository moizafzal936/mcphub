# Required in production (server refuses to start without it):
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Losing this key makes stored upstream API keys unrecoverable.
MCPHUB_ENCRYPTION_KEY=

NODE_ENV=production
PORT=3001

# Required in production: public https origin. Used as the OAuth issuer, MCP resource origin
# and for the CSRF Origin check.
MCPHUB_PUBLIC_URL=https://mcphub.example.com
# Set when behind a reverse proxy/load balancer (number of hops, or "true").
MCPHUB_TRUST_PROXY=1

# Cookies are Secure by default in production; only disable for local HTTP testing.
# MCPHUB_COOKIE_SECURE=true

# After the first (operator) account exists, sign-up is closed unless this is true.
# MCPHUB_ALLOW_SIGNUP=false

# Data directory for the SQLite database (back it up; it holds encrypted credentials).
# MCPHUB_DATA_DIR=/var/lib/mcphub

# Rate limits (per minute unless noted). Apps can also set their own per-app limit.
# MCPHUB_RATE_APP_PER_MIN=120
# MCPHUB_RATE_CLIENT_PER_MIN=60
# MCPHUB_RATE_API_PER_MIN=300
# MCPHUB_RATE_AUTH_PER_15MIN=10
# MCPHUB_RATE_SSE_CONNECT_PER_MIN=30
# MCPHUB_MAX_SSE_PER_APP=10
# MCPHUB_MAX_SSE_TOTAL=200

# Tool-call log retention.
# MCPHUB_LOG_RETENTION_DAYS=30
# MCPHUB_LOG_MAX_PER_APP=1000

# Default lifetime of new MCP access tokens (days).
# MCPHUB_MCP_TOKEN_DAYS=90

# Escape hatch for deliberately reaching internal APIs: exact "ip" or "ip:port" entries.
# Leave empty unless you understand the SSRF implications.
# MCPHUB_SSRF_ALLOW=

# Optional: enables the in-dashboard Claude playground.
# ANTHROPIC_API_KEY=
# MCPHUB_PLAYGROUND_MODEL=claude-sonnet-5-5

# Max characters of a tool result sent to AI clients (long lists are trimmed to whole items).
# MCPHUB_MAX_TOOL_RESPONSE_CHARS=40000
